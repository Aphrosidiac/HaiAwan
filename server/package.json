    "test": "node --test test/*.test.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^9.0.0",
    "fastify": "^5.12.5"
  }
}
