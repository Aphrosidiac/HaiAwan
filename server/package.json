{
  "name": "awan-server",
  "version": "0.1.0",
  "private": true,
  "description": "Awan API — auth, plans & quotas, companion chat, agent model proxy, suggestions, referrals.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
