PORT=8787
PUBLIC_API_URL=http://127.0.0.1:8787
PUBLIC_SITE_URL=http://127.0.0.1:5190
# One provider key powers chat, vision, speech, transcription and the agent proxy.
OPENROUTER_API_KEY=
# or OPENAI_API_KEY= (also enables realtime voice)
COMPANION_MODEL=anthropic/claude-sonnet-5.5
FAST_MODEL=anthropic/claude-haiku-4.5
AGENT_MODEL=openai/gpt-6-luna
SPEECH_MODEL=openai/gpt-audio
TRANSCRIBE_MODEL=google/gemini-3.5-flash-lite
# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe (test keys: sk_test_… / whsec_…). Unset → dev mode uses local checkout pages that activate plans and
# team seats without charging; production answers checkout with 501 billing_unavailable.
# Personal plans: POST /v1/billing/checkout (+ /portal). Teams: POST /v1/teams/:id/checkout {proSeats, maxSeats,
# interval, promoCode?} → one subscription with a Pro-seat and a Max-seat line item (quantity = seats), metadata
# team_id; a typed promo code must exist as a Stripe *promotion code* (else the buyer can enter one on Checkout).
# Point a webhook at <PUBLIC_API_URL>/v1/billing/webhook with these events: checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.paid, invoice.payment_failed. Enable the Customer
# Portal (Stripe Dashboard → Settings → Billing → Customer portal) with quantity changes allowed, so teams can
# change seat counts there.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_REFERRAL_COUPON=

# ── Sign-in email (magic links) ──────────────────────────────────────────────
# Whichever is configured is used (Resend wins when both are). With neither, dev mode logs the link
# and returns it as devLink; production answers POST /v1/auth/magic with 503.
MAIL_FROM="Awan <signin@awan.ffdev.studio>"
RESEND_API_KEY=
# or SMTP (minimal built-in client; port 465 = implicit TLS, anything else must offer STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM overrides MAIL_FROM for SMTP. SMTP_SECURE = tls | starttls | none (none: local relays only).
SMTP_FROM=
SMTP_SECURE=
# Abuse limits for sign-in links (defaults shown).
MAGIC_LINKS_PER_EMAIL=5
MAGIC_LINKS_PER_IP_HOUR=30

# ── First-party Google connectors (Gmail, Calendar, Drive, Docs, Sheets) ─────
# Uses the same GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET as Google sign-in. Add this redirect URI to the
# OAuth client:  <PUBLIC_API_URL>/v1/connectors/google/callback  and enable the Gmail, Calendar, Drive,
# Docs and Sheets APIs in the Google Cloud project.
# CONNECTOR_KEY encrypts users' Google tokens at rest (AES-256-GCM): 32 random bytes, base64 or hex.
# Generate your own — never reuse one from a doc, never commit a real one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Dev: when unset (and NODE_ENV != production) the server generates data/connector-dev.key (git-ignored).
# Production: required, and keep it stable — a new key means every user has to reconnect Google.
CONNECTOR_KEY=
# Google tool calls allowed per user per minute through the Awan-hosted MCP servers.
MCP_CALLS_PER_MINUTE=120

# ── Composio (Slack, Notion, LinkedIn, HubSpot… the long tail of app integrations) ──
# Project API key from https://platform.composio.dev (Settings → API keys). When set, /v1/config reports
# features.composio = true, the app merges Composio's catalogue into Settings → Integrations, and agents reach
# the user's connected apps through Awan's proxy at <PUBLIC_API_URL>/mcp/composio — the key never leaves the
# server. Awan creates or reuses one Composio-managed auth config per toolkit on its own. Connect pages bounce
# back through <PUBLIC_API_URL>/v1/composio/callback, so PUBLIC_API_URL must be reachable from the user's browser.
# Unset → every /v1/composio/* route answers 501 composio_not_configured.
COMPOSIO_API_KEY=
# Optional override of the REST base (default https://backend.composio.dev/api/v3.1).
COMPOSIO_API_BASE=
